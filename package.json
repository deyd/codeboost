{
    "name": "codeboost",
    "displayName": "CodeBoost",
    "icon": "images/codeboost_icon.png",
    "publisher": "Hijizou",
    "version": "1.3.0",
    "engines": {
        "vscode": "^1.92.0"
    },
    "description": "This extension simplifies the maintenance and usage of snippets.",
    "categories": [
        "Snippets"
    ],
    "keywords": [
        "competitive programming",
        "snippets"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "submenus": [
            {
                "id": "codeboost.submenu",
                "label": "Insert Markers"
            }
        ],
        "commands": [
            {
                "command": "codeboost.insertSnippet",
                "title": "Insert Snippet"
            },
            {
                "command": "codeboost.insertMainMarker",
                "title": "Insert Main Marker"
            },
            {
                "command": "codeboost.insertTestMarker",
                "title": "Insert Test Marker"
            },
            {
                "command": "codeboost.insertFromToMarker",
                "title": "Insert From / To Marker"
            },
            {
                "command": "codeboost.insertLineMarker",
                "title": "Insert Line Marker"
            },
            {
                "command": "codeboost.insertCommentMarker",
                "title": "Insert Comment Marker"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorFocus",
                    "command": "codeboost.insertSnippet",
                    "group": "myGroup@1"
                },
                {
                    "when": "editorFocus",
                    "submenu": "codeboost.submenu",
                    "group": "myGroup@2"
                }
            ],
            "codeboost.submenu": [
                {
                    "command": "codeboost.insertMainMarker",
                    "group": "myGroup@1"
                },
                {
                    "command": "codeboost.insertTestMarker",
                    "group": "myGroup@2"
                },
                {
                    "command": "codeboost.insertFromToMarker",
                    "group": "myGroup@3"
                },
                {
                    "command": "codeboost.insertLineMarker",
                    "group": "myGroup@4"
                },
                {
                    "command": "codeboost.insertCommentMarker",
                    "group": "myGroup@5"
                }
            ]
        },
        "configuration": {
            "title": "CodeBoost",
            "properties": {
                "codeboost.folderPath": {
                    "order": 0,
                    "type": "string",
                    "default": null,
                    "description": "Path of folder to browse"
                },
                "codeboost.languages": {
                    "order": 1,
                    "type": "object",
                    "default": {
                        "python": {
                            "extensions": [".py"],
                            "comment": "#"
                        },
                        "cpp": {
                            "extensions": [".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh", ".hxx"],
                            "comment": "//"
                        }
                    },
                    "description": "Language profiles. Files with extensions in the same profile share comment markers and snippet candidates.",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "extensions": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "comment": {
                                "type": "string"
                            }
                        },
                        "required": ["extensions", "comment"],
                        "additionalProperties": false
                    }
                },
                "codeboost.mainMarker": {
                    "order": 2,
                    "type": "string",
                    "default": "# -- main block -- #",
                    "description": "Start marker for the main part of the code"
                },
                "codeboost.testMarker": {
                    "order": 3,
                    "type": "string",
                    "default": "# -- test block -- #",
                    "description": "End marker for main part of code"
                },
                "codeboost.fromMarker": {
                    "order": 4,
                    "type": "string",
                    "default": "# -- tmp From -- #",
                    "description": "Start marker for partial test code"
                },
                "codeboost.toMarker": {
                    "order": 5,
                    "type": "string",
                    "default": "# -- tmp To -- #",
                    "description": "End marker for partial test code"
                },
                "codeboost.lineMarker": {
                    "order": 6,
                    "type": "string",
                    "default": "# ----",
                    "description": "Line markers to be deleted when quoting"
                },
                "codeboost.commentMarker": {
                    "order": 7,
                    "type": "string",
                    "default": "# ----",
                    "description": "Comment markers to be deleted when quoting"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.92.0",
        "@types/mocha": "^10.0.7",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^7.14.1",
        "@typescript-eslint/parser": "^7.11.0",
        "eslint": "^8.57.0",
        "typescript": "^5.4.5",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.4.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/deyd/codeboost.git"
    }
}